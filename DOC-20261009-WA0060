        /* Filmstrip style frame */
        .film-frame {
            background-color: #121212;
            border-left: 12px solid #000;
            border-right: 12px solid #000;
            position: relative;
            box-shadow: 0 10px 30px rgba(0,0,0,0.8);
        }

        .film-frame::before, .film-frame::after {
            content: "";
            position: absolute;
            top: 0; bottom: 0;
            width: 12px;
            background: repeating-linear-gradient(180deg, #fff 0px, #fff 8px, transparent 8px, transparent 20px);
            z-index: 10;
        }
        .film-frame::before { left: -12px; }
        .film-frame::after { right: -12px; }

        .heart-particle {
            position: fixed;
            pointer-events: none;
            z-index: 10;
            animation: floatUp 7s linear infinite;
            opacity: 0;
        }

        @keyframes floatUp {
