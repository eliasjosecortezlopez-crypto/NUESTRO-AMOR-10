    <script>
        // Exact text required by user
        const letterText = "Amor se que esto no es una cosa de otro mundo, pero para mi es algo increíble coincidir, estar acá mirándote a los ojos expresando te estas palabras que eh escrito para ti, el poder estar acá juntos, el que allá llegado nuestro día, que apartir de este día se define y se concreta todo lo que hemos pensado y soñado.";

        // YouTube IFrame API Initialization
        let player;
        let isPlaying = false;

        var tag = document.createElement('script');
        tag.src = "https://www.youtube.com/iframe_api";
        var firstScriptTag = document.getElementsByTagName('script')[0];
        firstScriptTag.parentNode.insertBefore(tag, firstScriptTag);

        function onYouTubeIframeAPIReady() {
            player = new YT.Player('ytplayer', {
                height: '0',
                width: '0',
                videoId: 'PxRP09ebl74', // "Ahí Estabas Tú" - Carín León
                playerVars: {
                    'autoplay': 0,
                    'controls': 0,
                    'loop': 1,
                    'playlist': 'PxRP09ebl74'
                },
                events: {
                    'onReady': onPlayerReady
                }
            });
        }

        function onPlayerReady(event) {
            // Player is ready
        }

        function startDashboard() {
            const welcomeScreen = document.getElementById('welcomeScreen');
            welcomeScreen.classList.add('opacity-0', 'pointer-events-none');

            // Play music if API ready
            if (player && player.playVideo) {
                player.playVideo();
                isPlaying = true;
                updateMusicUI();
            }

            showerLove();
            typeWriterEffect();
        }

        function toggleAudio() {
            if (!player) return;
            if (isPlaying) {
                player.pauseVideo();
                isPlaying = false;
            } else {
                player.playVideo();
                isPlaying = true;
            }
            updateMusicUI();
        }

        function updateMusicUI() {
            const vinyl = document.getElementById('vinylDisk');
            const playIcon = document.getElementById('playIcon');

            if (isPlaying) {
                vinyl.classList.add('animate-spin-slow');
                playIcon.className = 'fas fa-pause text-xs';
            } else {
                vinyl.classList.remove('animate-spin-slow');
                playIcon.className = 'fas fa-play text-xs pl-0.5';
            }
        }

        // Typewriter Effect for Letter
        function typeWriterEffect() {
            const elem = document.getElementById('typedLetter');
            elem.innerHTML = '';
            let i = 0;
            const speed = 30;

            function type() {
                if (i < letterText.length) {
                    elem.innerHTML += letterText.charAt(i);
                    i++;
                    setTimeout(type, speed);
                }
            }
            type();
        }

        // Countdown Timer Logic from 10/01/2026
        const startDate = new Date("2026-01-10T00:00:00").getTime();

        function updateCounter() {
            const now = new Date().getTime();
            const diff = Math.abs(now - startDate);

            const days = Math.floor(diff / (1000 * 60 * 60 * 24));
            const hours = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
            const minutes = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
            const seconds = Math.floor((diff % (1000 * 60)) / 1000);

            document.getElementById("cntDays").innerText = days < 10 ? "0" + days : days;
            document.getElementById("cntHours").innerText = hours < 10 ? "0" + hours : hours;
            document.getElementById("cntMinutes").innerText = minutes < 10 ? "0" + minutes : minutes;
            document.getElementById("cntSeconds").innerText = seconds < 10 ? "0" + seconds : seconds;
        }

        setInterval(updateCounter, 1000);
        updateCounter();

        // Image Fallback Generator
        function handleImgError(imgElem, title) {
            const canvas = document.createElement("canvas");
            canvas.width = 400;
            canvas.height = 700;
            const ctx = canvas.getContext("2d");

            const grad = ctx.createLinearGradient(0, 0, 400, 700);
            grad.addColorStop(0, "#881337");
            grad.addColorStop(1, "#170308");
            ctx.fillStyle = grad;
            ctx.fillRect(0, 0, 400, 700);

            ctx.fillStyle = "#fb7185";
            ctx.font = "60px FontAwesome, sans-serif";
            ctx.textAlign = "center";
            ctx.fillText("❤️", 200, 320);

            ctx.fillStyle = "#fde047";
            ctx.font = "bold 24px Montserrat, sans-serif";
            ctx.fillText("10/01/2026", 200, 390);

            ctx.fillStyle = "#ffe4e6";
            ctx.font = "16px Montserrat, sans-serif";
            ctx.fillText(title, 200, 430);

            imgElem.src = canvas.toDataURL("image/png");
        }

        // Custom image uploader handler
        function loadCustomImages(event) {
            const files = event.target.files;
            if (!files || files.length === 0) return;

            const ids = ["img1", "img2", "img3"];
            for (let i = 0; i < Math.min(files.length, 3); i++) {
                const reader = new FileReader();
                const targetImg = document.getElementById(ids[i]);
                reader.onload = function(e) {
                    targetImg.src = e.target.result;
                };
                reader.readAsDataURL(files[i]);
            }
            showerLove();
        }

        // Zoom Modal
        function zoomImage(src, caption) {
            document.getElementById('modalImg').src = src;
            document.getElementById('modalCaption').innerText = caption;
            const modal = document.getElementById('zoomModal');
            modal.classList.remove('opacity-0', 'pointer-events-none');
        }

        function closeZoom() {
            const modal = document.getElementById('zoomModal');
            modal.classList.add('opacity-0', 'pointer-events-none');
        }

        // Floating Hearts Background
        function createHearts() {
            const container = document.getElementById("heartsContainer");
            const symbols = ["❤️", "💖", "✨", "💕", "🌹"];

            for (let i = 0; i < 20; i++) {
                const heart = document.createElement("div");
                heart.className = "heart-particle";
                heart.innerText = symbols[Math.floor(Math.random() * symbols.length)];
                heart.style.left = Math.random() * 100 + "vw";
                heart.style.animationDuration = (Math.random() * 4 + 5) + "s";
                heart.style.animationDelay = (Math.random() * 5) + "s";
                heart.style.fontSize = (Math.random() * 16 + 12) + "px";
                container.appendChild(heart);
            }
        }
        createHearts();

        // Confetti Heart Shower
        function showerLove() {
            const end = Date.now() + 2 * 1000;
            const colors = ['#f43f5e', '#fbbf24', '#ffe4e6'];

            (function frame() {
                confetti({
                    particleCount: 3,
                    angle: 60,
                    spread: 55,
                    origin: { x: 0 },
                    colors: colors
                });
                confetti({
                    particleCount: 3,
                    angle: 120,
                    spread: 55,
                    origin: { x: 1 },
                    colors: colors
                });

                if (Date.now() < end) {
                    requestAnimationFrame(frame);
                }
            })();
        }
    </script>
</body>
</html>